# Public browser configuration only. Never put a Google client secret here.
# OAuth 2.0 Web client ID used by Google Identity Services.
VITE_GOOGLE_CLIENT_ID=

# Required only for Google Picker import. Restrict this key by website and API.
VITE_GOOGLE_PICKER_API_KEY=

# Numeric Google Cloud project number used as Picker App ID.
VITE_GOOGLE_APP_ID=
