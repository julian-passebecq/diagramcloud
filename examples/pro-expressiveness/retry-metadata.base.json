      "language": "python",
      "code": "from functools import wraps\n\ndef retry(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        # A bounded retry policy belongs here.\n        return func(*args, **kwargs)\n    return wrapper"
