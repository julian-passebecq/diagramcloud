  "blocks": [
    {
      "id": "b.business",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Help a reviewer find permitted source material and understand why it matters. A public site sees only deliberately published excerpts, not the private originals."
    },
    {
      "id": "b.application",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Browse, search and inspect source-backed entries. A feature is not identical to a route, package or UI control."
    },
    {
      "id": "b.domain",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Entry, asset version, permission label and editorial claim have distinct identities and grains."
    },
    {
      "id": "b.delivery",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Repository, build, artifact, environment and release receipt are separate. A preview is not production."
    },
    {
      "id": "b.decision",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "An editor explicitly chooses material for an audience. Search must operate on that permitted cut; hiding a card after searching private content is insufficient."
    },
    {
      "id": "b.browser",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Displays permitted entries and an inspector. Keeps reading state separate from editable content and never stores service credentials."
    },
    {
      "id": "b.api",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Validates the caller and request, checks resource-level permissions, and returns an explicit result. A browser button is not server authorization."
    },
    {
      "id": "b.identity",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Authenticates the caller and enforces requested resource/action scope. A role display in the UI does not establish a server-side check."
    },
    {
      "id": "b.metadata",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Stores stable entry IDs, asset-version references and editorial state. One row has a defined grain; do not turn every rendered occurrence into another entity."
    },
    {
      "id": "b.objects",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Contains approved example bytes. A locator does not grant access. Public derivatives are separate from private originals."
    },
    {
      "id": "b.index",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Search returns only the allowed audience/scope. Derived index text is not an additional source of truth."
    },
    {
      "id": "b.worker",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Produces derived metadata/thumbnails for selected bytes. A reported success must bind to the exact input and output identities."
    },
    {
      "id": "b.telemetry",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Records sanitized outcomes and correlation IDs. It must not leak raw answers, credentials or private document contents."
    },
    {
      "id": "b.entry",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "One catalogued item with an ID, title, subject and publication state."
    },
    {
      "id": "b.asset-version",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "One exact immutable file version, digest and source locator. An edited file is a new version."
    },
    {
      "id": "b.claim",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "One authored statement with supporting source references. A citation is inspectable support, not automatic truth."
    },
    {
      "id": "b.mapping",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Connects an entry, business subject and source version. Name similarity does not establish identity."
    },
    {
      "id": "b.request-input",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Example: fetch one entry by stable ID. Input is checked by the API; displayed snippets never run here."
    },
    {
      "id": "b.response",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "A response is scoped and schema-checked. Missing and unauthorized resources should not leak private existence through rich diagnostics."
    },
    {
      "id": "b.repo",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Owns application code and reviewed changes. Company membership and repository ownership are not the same relation."
    },
    {
      "id": "b.ci-job",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Runs selected checks on a specified source revision with an explicit environment. A workflow definition is not a passing run."
    },
    {
      "id": "b.artifact",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Produced files have an identity separate from the source commit and their eventual installed location."
    },
    {
      "id": "b.environment",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "An environment may be local, test or production only when supplied. This example defines no real target and grants no deployment."
    },
    {
      "id": "b.iac-plan",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "The candidate infrastructure change is reviewed separately from executing it. Secret-bearing plan/state data does not belong in the public explanation."
    },
    {
      "id": "b.receipt",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Bindings distinguish built, installed, qualified and delivered. An unresolved gate remains unknown or open; no elapsed time is inferred."
    },
    {
      "id": "b.open-request",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Navigation to one request path; not another API service."
    },
    {
      "id": "b.open-data",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Navigation to data meaning; it does not create or execute a query."
    },
    {
      "id": "b.open-ops",
      "title": "Meaning, assumptions and next question",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "text",
      "text": "Navigation to delivery design; it does not create an infrastructure resource."
    },
